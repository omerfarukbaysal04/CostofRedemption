  dialogueText: {fileID: 1482627860}
  dialogue:
  - I'm waiting for my laundry to dry.
  - Old age is hard, my son.
  - Loneliness is hard too.
  - This village would not exist without you.
  - Your loss is our loss.
  - That little guy used to run around here.
  - Ah, the old days.
  - Anyway, son, I won't keep you.
  wordSpeed: 0.02
  playerIsClose: 0
  interactIndicator: {fileID: 264755706}
