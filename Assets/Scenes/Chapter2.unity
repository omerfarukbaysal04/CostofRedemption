  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 1051934789}
  dialogueText: {fileID: 1404923820}
  dialogue:
  - ...
  - What am I going to do!
  - My family's blood is on their hands!
  - ...
  - They'll kill me if I don't.
  - There are no more guards in the village with my skills.
  - ...
  - I have to do this to protect the village.
  - Lord..
  - We haven't seen each other for a long time.
  - He didn't even try to prevent the war between these two villages!
  - What about the guns?
  - What does he want it for?
  - And to attack us.
  - ...
  - Oh, shit. Oh, shit.
  - (move forward)
  wordSpeed: 0.02
  playerIsClose: 0
  interactIndicator: {fileID: 90293103}
