  dialoguePanel: {fileID: 1519677473}
  dialogueText: {fileID: 1171471340}
  dialogue:
  - My wife gets angry with me for coming home late.
  - You tell me, warrior, how to go.
  - There are children at home waiting for food.
  - I believe that one day this misery will end.
  - I trust the mayor. He'll find the crook who stole the money.
  - Yes, I think our money is being stolen.
  - I hope it will be found.
  - This is all the game of the enemy village!
  wordSpeed: 0.02
  playerIsClose: 0
  interactIndicator: {fileID: 2105194631}
